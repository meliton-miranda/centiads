# Postgres en Hostinger (backbone). Vercel y el loader usan esta misma URL.
# Formato: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://usuario:password@host.hostinger:5432/netus_ads_cockpit

# Si el Postgres de Hostinger NO usa SSL, poner disable. Por defecto se intenta SSL laxo.
# PGSSL=disable

# GHL: base de la API. Los PIT por subcuenta viven en cockpit.clients (no aquí).
GHL_API_BASE=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28
